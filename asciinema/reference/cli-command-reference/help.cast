[1.078323, "o", "\r\n"]
[1.078387, "o", "Available commands:\r\n"]
[1.078558, "o", "  netinfo         Collect network information from the target system.\r\n  download        Download a file from the target system.\r\n  exec            Execute a command on the target system.\r\n  llama           Interact with Llama AI on the target system.\r\n  beacons         Manage beacon configurations.\r\n  sysinfo         Collect detailed system information from the target.\r\n  listeners       Manage C2 listeners.\r\n  use             Manage and use extensions.\r\n  help            Display help information about available commands.\r\n  workflow        Manage automated workflows.\r\n  ps              Display the process list on the target system.\r\n  memdb           Query the implant's in-memory database.\r\n  sessions        Manage agent sessions.\r\n  generate        Generate payloads.\r\n  shell           Start an interactive shell on the target system.\r\n  interact        Interact with a specific agent session.\r\n"]
[1.078588, "o", "  ls              List files and directories on the target system.\r\n  cd              Change the working directory on the target system.\r\n  upload          Upload a file to the target system.\r\n  pwd             Print the current working directory on the target system.\r\n  info            Display detailed information about the current session.\r\n\r\nUse 'help <command>' for more information about a specific command.\r\nvirga> "]
